# HubSpot private app token with read scopes for contacts, companies and deals.
HUBSPOT_API_KEY=your_hubspot_private_app_token

# BigQuery destination.
GCP_PROJECT_ID=your_gcp_project_id
GCP_DATASET_ID=crm_raw
GCP_LOCATION=EU
GOOGLE_APPLICATION_CREDENTIALS=./gcp_credentials.json

# Optional extractor tuning.
# Minutes of overlap re-read on every run, to catch records modified mid-run.
EXTRACT_LOOKBACK_MINUTES=5
HUBSPOT_PAGE_SIZE=100
HUBSPOT_MAX_RETRIES=5
